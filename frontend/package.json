{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:all": "concurrently -n frontend,backend -c \"green,blue\" \"npm run dev\" \"cd ../backend && venv\\Scripts\\Activate && venv\\Scripts\\python.exe app.py\"",
    "start:frontend": "npm run dev -c \"green\"",
    "start:backend": "cd ../backend && venv\\Scripts\\Activate && venv\\Scripts\\python.exe app.py -c \"blue\"",
    "test": "vitest",
    "test:ci": "vitest --run",
    "test:all": "concurrently -n frontend -c green \"npm run test\" && concurrently -n backend -c blue \"cd ../backend && venv\\Scripts\\python.exe -m pytest\""
  },  
"dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "jsdom": "^27.0.1",
    "vite": "^7.1.7",
    "vitest": "^4.0.2"
  }
}
